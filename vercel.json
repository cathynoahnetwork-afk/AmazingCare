{
  "redirects": [
    {
      "source": "/en",
      "destination": "/index.html?lang=en",
      "permanent": true
    },
    {
      "source": "/en/",
      "destination": "/index.html?lang=en",
      "permanent": true
    },
    {
      "source": "/en/:page",
      "destination": "/:page?lang=en",
      "permanent": true
    },
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    }
  ]
}
